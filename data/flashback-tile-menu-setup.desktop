[Desktop Entry]
Version=1.0
Type=Application
Name=Tiling and resolution menu setup
Comment=Add the window tiling and resolution menus to the GNOME Flashback panel once per user
Exec=flashback-tile-menu-setup all --auto
Terminal=false
NoDisplay=true
OnlyShowIn=GNOME-Flashback;
